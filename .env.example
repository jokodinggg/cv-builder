# PostgreSQL connection used by the app. On Vercel + Supabase use the pooler URL
# (port 6543, add ?pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://USER@localhost:5432/cv_builder"
# Direct (non-pooled) connection used by `prisma migrate`. Locally: same as DATABASE_URL.
# Supabase: the "Direct connection" or "Session pooler" URL (port 5432).
DIRECT_URL="postgresql://USER@localhost:5432/cv_builder"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public base URL of this app (used for auth callbacks and PDF rendering)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google sign-in. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Cloudflare Turnstile (invisible captcha on sign-up / sign-in / password reset).
# Create an "Invisible" widget at dash.cloudflare.com → Turnstile. Leave empty to disable.
# Local testing: site key 1x00000000000000000000BB + secret 1x0000000000000000000000000000000AA always pass.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: Chrome/Chromium path for PDF export. Auto-detected when empty.
CHROME_EXECUTABLE_PATH=""
# Optional: origin headless Chrome uses to open the print page. Defaults to BETTER_AUTH_URL.
PDF_RENDER_ORIGIN=""

# Tests only: separate database used by `pnpm test` (never point it at real data).
TEST_DATABASE_URL="postgresql://USER@localhost:5432/cv_builder_test"
