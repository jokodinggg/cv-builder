# PostgreSQL connection string
DATABASE_URL="postgresql://USER@localhost:5432/cv_builder"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public base URL of this app (used for auth callbacks and PDF rendering)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google sign-in. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Claude translation. Without it, the free Google endpoint is used.
ANTHROPIC_API_KEY=""

# Optional: Chrome/Chromium path for PDF export. Auto-detected when empty.
CHROME_EXECUTABLE_PATH=""
